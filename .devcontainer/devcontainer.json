{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "TaskBoard Demo",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:UTC}"
    }
  },
  "init": true,

  // Colima only shares $HOME with the VM, so every bind source below must live
  // under the host home directory -- a mount from /tmp silently comes up empty.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",

  "mounts": [
    // Semgrep Guardian OIDC credentials. Read-write: Guardian refreshes the
    // token in place, and a refreshed token should outlive the container.
    "source=${localEnv:HOME}/.semgrep,target=/home/vscode/.semgrep,type=bind",
    // Claude Code login + plugin state. A named volume rather than a bind of
    // the host ~/.claude: on macOS the host credentials live in the Keychain,
    // not on disk, so a bind would carry no auth -- and it would leak container
    // session state back into the host config. Seeded from the image on first
    // use, then persists, so `claude auth login` is a one-time step.
    "source=taskboard-demo-claude,target=/home/vscode/.claude,type=volume"
  ],

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "CLAUDE_SEED_DIR": "/opt/claude-seed",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  },

  // Match the container user to the host UID so the mode-0600 files in
  // ~/.semgrep stay readable through virtiofs.
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,

  // Runs on every start, not just create: a rebuilt image must be able to push
  // a newer Guardian plugin into an existing ~/.claude volume.
  "postStartCommand": "python3 /opt/post_create.py",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
